<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:cim="http://iec.ch/TC57/2012/CIM-schema-cim16#" xmlns:md="http://iec.ch/TC57/61970-552/ModelDescription/1#">
  <md:FullModel rdf:about="urn:uuid:8c1a6e2e-1111-4a11-9a11-000000000001">
    <md:Model.created>2026-08-05T00:00:00Z</md:Model.created>
    <md:Model.description>Minimal 2-bus test case: AC line (recognized) + Breaker (unrecognized element type)</md:Model.description>
    <md:Model.version>1</md:Model.version>
  </md:FullModel>

  <!-- Base voltage -->
  <cim:BaseVoltage rdf:ID="_bv_20kv">
    <cim:IdentifiedObject.name>20.0 kV</cim:IdentifiedObject.name>
    <cim:BaseVoltage.nominalVoltage>20.0</cim:BaseVoltage.nominalVoltage>
  </cim:BaseVoltage>

  <!-- Substations (buses) -->
  <cim:Substation rdf:ID="_sub_a">
    <cim:IdentifiedObject.name>Sub_A</cim:IdentifiedObject.name>
  </cim:Substation>
  <cim:Substation rdf:ID="_sub_b">
    <cim:IdentifiedObject.name>Sub_B</cim:IdentifiedObject.name>
  </cim:Substation>

  <cim:VoltageLevel rdf:ID="_vl_a">
    <cim:IdentifiedObject.name>Sub_A 20kV</cim:IdentifiedObject.name>
    <cim:VoltageLevel.Substation rdf:resource="#_sub_a"/>
    <cim:VoltageLevel.BaseVoltage rdf:resource="#_bv_20kv"/>
  </cim:VoltageLevel>
  <cim:VoltageLevel rdf:ID="_vl_b">
    <cim:IdentifiedObject.name>Sub_B 20kV</cim:IdentifiedObject.name>
    <cim:VoltageLevel.Substation rdf:resource="#_sub_b"/>
    <cim:VoltageLevel.BaseVoltage rdf:resource="#_bv_20kv"/>
  </cim:VoltageLevel>

  <!-- Recognized element: ACLineSegment connecting Sub_A -> Sub_B -->
  <cim:ACLineSegment rdf:ID="_line_ab">
    <cim:IdentifiedObject.name>Line_A_B</cim:IdentifiedObject.name>
    <cim:ConductingEquipment.BaseVoltage rdf:resource="#_bv_20kv"/>
    <cim:Conductor.length>2.5</cim:Conductor.length>
    <cim:ACLineSegment.r>0.12</cim:ACLineSegment.r>
    <cim:ACLineSegment.x>0.30</cim:ACLineSegment.x>
    <cim:ACLineSegment.bch>0.00004</cim:ACLineSegment.bch>
  </cim:ACLineSegment>
  <cim:Terminal rdf:ID="_t_line_a">
    <cim:ACDCTerminal.sequenceNumber>1</cim:ACDCTerminal.sequenceNumber>
    <cim:Terminal.ConductingEquipment rdf:resource="#_line_ab"/>
    <cim:Terminal.TopologicalNode rdf:resource="#_node_a"/>
  </cim:Terminal>
  <cim:Terminal rdf:ID="_t_line_b">
    <cim:ACDCTerminal.sequenceNumber>2</cim:ACDCTerminal.sequenceNumber>
    <cim:Terminal.ConductingEquipment rdf:resource="#_line_ab"/>
    <cim:Terminal.TopologicalNode rdf:resource="#_node_b"/>
  </cim:Terminal>

  <!-- Unrecognized element: Breaker has no matching branch in parse_equipment(),
       so it (and its terminals below) will be reported by the new WARNING log
       but silently excluded from the graph model, same as before the fix. -->
  <cim:Breaker rdf:ID="_brk_ab">
    <cim:IdentifiedObject.name>BRK_A_B</cim:IdentifiedObject.name>
    <cim:ConductingEquipment.BaseVoltage rdf:resource="#_bv_20kv"/>
    <cim:Switch.normalOpen>false</cim:Switch.normalOpen>
  </cim:Breaker>
  <cim:Terminal rdf:ID="_t_brk_a">
    <cim:ACDCTerminal.sequenceNumber>1</cim:ACDCTerminal.sequenceNumber>
    <cim:Terminal.ConductingEquipment rdf:resource="#_brk_ab"/>
    <cim:Terminal.TopologicalNode rdf:resource="#_node_a"/>
  </cim:Terminal>
  <cim:Terminal rdf:ID="_t_brk_b">
    <cim:ACDCTerminal.sequenceNumber>2</cim:ACDCTerminal.sequenceNumber>
    <cim:Terminal.ConductingEquipment rdf:resource="#_brk_ab"/>
    <cim:Terminal.TopologicalNode rdf:resource="#_node_b"/>
  </cim:Terminal>

  <!-- A load at Sub_B so the graph has more than just buses/lines -->
  <cim:EnergyConsumer rdf:ID="_load_b">
    <cim:IdentifiedObject.name>Load_B</cim:IdentifiedObject.name>
  </cim:EnergyConsumer>
  <cim:Terminal rdf:ID="_t_load_b">
    <cim:ACDCTerminal.sequenceNumber>1</cim:ACDCTerminal.sequenceNumber>
    <cim:Terminal.ConductingEquipment rdf:resource="#_load_b"/>
    <cim:Terminal.TopologicalNode rdf:resource="#_node_b"/>
  </cim:Terminal>
  <cim:SvPowerFlow rdf:ID="_svpf_load_b">
    <cim:SvPowerFlow.p>100.0</cim:SvPowerFlow.p>
    <cim:SvPowerFlow.q>30.0</cim:SvPowerFlow.q>
    <cim:SvPowerFlow.Terminal rdf:resource="#_t_load_b"/>
  </cim:SvPowerFlow>

  <!-- Topology: one node per substation -->
  <cim:TopologicalNode rdf:ID="_node_a">
    <cim:IdentifiedObject.name>Node_A</cim:IdentifiedObject.name>
    <cim:TopologicalNode.BaseVoltage rdf:resource="#_bv_20kv"/>
    <cim:TopologicalNode.ConnectivityNodeContainer rdf:resource="#_vl_a"/>
  </cim:TopologicalNode>
  <cim:TopologicalNode rdf:ID="_node_b">
    <cim:IdentifiedObject.name>Node_B</cim:IdentifiedObject.name>
    <cim:TopologicalNode.BaseVoltage rdf:resource="#_bv_20kv"/>
    <cim:TopologicalNode.ConnectivityNodeContainer rdf:resource="#_vl_b"/>
  </cim:TopologicalNode>

  <!-- State variables: Node_A is the slack bus (angle == 0) -->
  <cim:SvVoltage rdf:ID="_sv_a">
    <cim:SvVoltage.v>20.0</cim:SvVoltage.v>
    <cim:SvVoltage.angle>0.0</cim:SvVoltage.angle>
    <cim:SvVoltage.TopologicalNode rdf:resource="#_node_a"/>
  </cim:SvVoltage>
  <cim:SvVoltage rdf:ID="_sv_b">
    <cim:SvVoltage.v>19.6</cim:SvVoltage.v>
    <cim:SvVoltage.angle>-2.1</cim:SvVoltage.angle>
    <cim:SvVoltage.TopologicalNode rdf:resource="#_node_b"/>
  </cim:SvVoltage>

</rdf:RDF>
